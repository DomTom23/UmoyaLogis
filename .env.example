# Skopiuj do pliku .env i uzupelnij. Plik .env nie trafia do repozytorium.

# Wspolne haslo do aplikacji (zostaw puste, jesli siec biurowa jest zaufana i haslo niepotrzebne)
APP_PASSWORD=

# Port, na ktorym aplikacja jest dostepna w sieci biurowej (http://ADRES_SERWERA:PORT)
APP_PORT=8501

# Serwer tras dla ciezarowek. Publiczny ma limit 1500 km na zapytanie i nie jest przeznaczony do duzego ruchu -
# do codziennej pracy biura postaw wlasny serwer Valhalla i wpisz tu jego adres, np. http://valhalla:8002
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Opcjonalnie: klucz OpenRouteService (alternatywny silnik tras)
ORS_API_KEY=
