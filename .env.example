# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Wspólne hasło do aplikacji (zostaw puste, jeśli sieć biurowa jest zaufana i hasło niepotrzebne)
APP_PASSWORD=

# Port, na którym aplikacja jest dostępna w sieci biurowej (http://ADRES_SERWERA:PORT)
APP_PORT=8501

# Serwer tras dla ciężarówek. Publiczny ma limit 1500 km na zapytanie i nie jest przeznaczony do dużego ruchu -
# do codziennej pracy biura postaw własny serwer Valhalla i wpisz tu jego adres, np. http://valhalla:8002
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Opcjonalnie: klucz OpenRouteService (alternatywny silnik tras)
ORS_API_KEY=
